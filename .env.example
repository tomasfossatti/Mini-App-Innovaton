# Postgres (Neon, Supabase o local). Para poolers usar la URL "pooled".
DATABASE_URL=postgres://innovaton:innovaton@localhost:5432/innovaton
# Opcional: URL directa (sin pooler) para correr migraciones. Si falta se usa DATABASE_URL.
# MIGRATION_DATABASE_URL=


# Cuenta ADMIN inicial (el seed la crea si no existe; no cambia contraseñas existentes).
# En producción usar una contraseña propia de 8+ caracteres, nunca este valor de ejemplo.
ADMIN_EMAIL=admin@espacioidi.local
ADMIN_PASSWORD=cambiar-esta-clave
ADMIN_NAME=Admin Espacio IDI

# Evento al que redirige la raíz "/" (el QR puede apuntar a la raíz o a /e/<slug>).
DEFAULT_EVENT_SLUG=innovaton-demo

# Seed de datos DEMO (evento + 6 desafíos ficticios). "false" para no crearlos.
SEED_DEMO=true
# Fecha del evento DEMO (YYYY-MM-DD). Si falta, se usa el día siguiente al seed.
# DEMO_EVENT_DATE=2026-10-15

# País por defecto para normalizar WhatsApp.
DEFAULT_PHONE_COUNTRY=AR

# URL pública para el QR imprimible. En producción, el dominio de producción de Vercel.
# Si falta, se toma del dominio desde el que se abre la pestaña Imprimir.
# PUBLIC_BASE_URL=https://innovaton.example.com
